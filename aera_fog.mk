#
# AERA Recovery configuration for Xiaomi Redmi 10C (fog)
#
# SPDX-License-Identifier: Apache-2.0
#

DEVICE_PATH := device/xiaomi/fog
AERA_MAINTAINER := romeo13card

# Display: 
AERA_SCREEN_H := 1650
AERA_STATUS_H := 96
AERA_STATUS_INDENT_LEFT := 36
AERA_STATUS_INDENT_RIGHT := 36
AERA_HIDE_NOTCH := 1
AERA_CLOCK_POS := 1
AERA_ALLOW_DISABLE_NAVBAR := 0
AERA_OPTIONS_LIST_NUM := 6

# Flashlight: 
AERA_FLASHLIGHT_ENABLE := 0
AERA_USE_GREEN_LED := 0

# Dynamic partitions and boot control.
AERA_DISPLAY_FORMAT_FILESYSTEMS_DEBUG_INFO := 1
AERA_DYNAMIC_FULL_SIZE := $(BOARD_SUPER_PARTITION_SIZE)
AERA_ENABLE_ALL_PARTITION_TOOLS := 1
AERA_USE_DMCTL := 1
AERA_USE_AIDL_BOOT_CONTROL := 0

# fog uses recovery-as-boot; do not set AERA_AB_DEVICE_WITH_RECOVERY_PARTITION.

# Userdata uses F2FS on this device.
AERA_FORCE_DATA_FORMAT_F2FS := 1
AERA_FORCE_CASEFOLDING := 1
AERA_UNBIND_SDCARD_F2FS := 1
AERA_BIND_MOUNT_SDCARD_ON_FORMAT := 1
AERA_UNMOUNT_SDCARDS_BEFORE_REBOOT := 1
AERA_WIPE_METADATA_AFTER_DATAFORMAT := 1
AERA_WORKAROUND_BACKUP_BUG := 1

# Use the supplied prebuilt kernel and enable LZ4 recovery compression.
AERA_FORCE_PREBUILT_KERNEL := 1
AERA_USE_LZ4_COMPRESSION := 1
AERA_NO_RELOAD_AFTER_DECRYPTION := 1
AERA_NO_TREBLE_COMPATIBILITY_CHECK := 1

# Enable AERA's WLAN support for the Qualcomm platform.
AERA_ENABLE_WLAN := 1
